# 复制本文件为 .env 并按需修改。.env 不会进 git（已被 .gitignore 忽略）。
# docker-compose.yml 会读这些值来初始化 Postgres。

POSTGRES_USER=labelhub
POSTGRES_PASSWORD=labelhub_dev_pwd
POSTGRES_DB=labelhub

# Day 3 给 Prisma 用的完整连接串（格式：postgresql://用户:密码@主机:端口/库名）
DATABASE_URL=postgresql://labelhub:labelhub_dev_pwd@localhost:5434/labelhub
